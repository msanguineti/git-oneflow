{
  "name": "git-oneflow",
  "version": "3.1.0",
  "description": "CLI tooling implementing GIT OneFlow branching model",
  "bin": {
    "gof": "bin/index.js",
    "git-oneflow": "bin/index.js"
  },
  "engines": {
    "node": ">=22.8.0",
    "npm": ">=10",
    "yarn": "please-use-npm",
    "pnpm": "please-use-npm"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test",
    "clean": "node -e \"require('node:fs').rmSync('bin', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --noEmit false --outDir bin",
    "watch": "tsc --noEmit false --outDir bin --watch",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "prepare": "husky",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msanguineti/git-oneflow.git"
  },
  "keywords": [
    "git",
    "oneflow",
    "branching",
    "model",
    "Adam",
    "Ruka",
    "cli"
  ],
  "author": "Mirco Sanguineti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/msanguineti/git-oneflow/issues"
  },
  "homepage": "https://github.com/msanguineti/git-oneflow#readme",
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@types/inquirer": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "inquirer": "^9.2.14"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.ts": "eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
