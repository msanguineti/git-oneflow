{
  "name": "git-oneflow",
  "version": "4.0.2",
  "description": "Command-line tools for the OneFlow Git workflow: feature, release and hotfix branches.",
  "bin": {
    "gof": "bin/index.js",
    "git-oneflow": "bin/index.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.2 || >=26.13.0",
    "npm": ">=10",
    "yarn": "please-use-npm",
    "pnpm": "please-use-npm"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test",
    "clean": "node -e \"require('node:fs').rmSync('bin', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --noEmit false --outDir bin",
    "watch": "tsc --noEmit false --outDir bin --watch",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "prepare": "husky",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msanguineti/git-oneflow.git"
  },
  "keywords": [
    "git",
    "oneflow",
    "git-workflow",
    "branching-model",
    "version-control",
    "cli",
    "command-line",
    "feature-branch",
    "release-branch",
    "hotfix"
  ],
  "author": "Mirco Sanguineti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/msanguineti/git-oneflow/issues"
  },
  "homepage": "https://github.com/msanguineti/git-oneflow#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "cosmiconfig": "^10.0.1",
    "inquirer": "^14.3.0"
  },
  "lint-staged": {
    "**/*.ts": "eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
